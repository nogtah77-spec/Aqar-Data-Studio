{
  "buildCommand": "(cd ../.. && pnpm run typecheck:libs) && pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon|robots|manifest).*)",
      "destination": "/index.html"
    }
  ]
}
